{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job-Alert-Monitor",
  "identifier": "de.cxecutives.job-alert-monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Job-Alert-Monitor",
        "width": 1360,
        "height": 900,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "theme": "Light",
        "backgroundColor": "#F8F5F1",
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
