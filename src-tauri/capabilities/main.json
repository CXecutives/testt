{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Rights of the app's own interface - the main window only. Portal windows are deliberately in no capability; there is never a remote entry.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-state",
    "allow-cancel-run",
    "allow-ai-prompt",
    "allow-ai-prompt-top",
    "allow-clear-txt",
    "allow-empty-trash",
    "allow-job-detail",
    "allow-list-jobs",
    "allow-mark-all-read",
    "allow-mark-read",
    "allow-mark-unread",
    "allow-move-jobs",
    "allow-move-back",
    "allow-restore-jobs",
    "allow-open-target",
    "allow-parse-profile",
    "allow-pick-profile",
    "allow-pick-workspace",
    "allow-portal-login",
    "allow-portal-logout",
    "allow-profile-prompt",
    "allow-remove-mailbox",
    "allow-remove-profile",
    "allow-restore-profile",
    "allow-set-unsaved",
    "allow-close-window",
    "allow-report-ui-error",
    "allow-reset-all",
    "allow-rewrite-txt",
    "allow-save-mailbox",
    "allow-save-profile",
    "allow-save-settings",
    "allow-purge-jobs",
    "allow-set-override",
    "allow-set-pinned",
    "allow-start-run",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close"
  ]
}
