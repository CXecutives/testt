{
  "about": "The one filter of contact data for everything that sends the profile to an AI: the app's prompts (core/src/export/personal.rs) and the skill's brief (scripts/matching.py) read this file. A key is normalised (lower case, umlauts spelled out, every other character an underscore) and left out with its value when it contains a part of keyParts, has a token of keyTokens, or holds prose; the consultant's name is left out at the top of the profile and anywhere below a personal section. Every text value loses what valuePatterns match. Tested with the same cases on both sides (tests/personal_cases.json).",
  "keyParts": [
    "mail",
    "telefon",
    "phone",
    "handy",
    "adress",
    "anschrift",
    "strasse",
    "street",
    "hausnummer",
    "postleitzahl",
    "wohnort",
    "geburt",
    "birth",
    "kontakt",
    "contact",
    "linkedin",
    "xing",
    "github",
    "website",
    "webseite",
    "homepage",
    "social",
    "iban",
    "steuernummer",
    "steuer_id",
    "ust_id",
    "ustid",
    "nationalit",
    "staatsangehoerig",
    "familienstand",
    "signatur"
  ],
  "keyTokens": [
    "tel",
    "fax",
    "mobil",
    "mobile",
    "mobilnummer",
    "plz",
    "zip",
    "ort",
    "url",
    "urls",
    "link",
    "links",
    "web",
    "www",
    "foto",
    "photo",
    "bild",
    "avatar",
    "bic"
  ],
  "nameKeys": [
    "name",
    "vorname",
    "nachname",
    "familienname",
    "rufname",
    "full_name",
    "fullname",
    "first_name",
    "firstname",
    "last_name",
