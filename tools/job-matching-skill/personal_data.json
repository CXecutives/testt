    "referenz",
    "reference",
    "testimonial",
    "kundenstimme",
    "case_stud",
    "fallstudie",
    "zitat",
    "quote"
  ],
  "valuePatterns": [
    "[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+",
    "(?i)\\b(?:https?://|www\\.)\\S+",
    "(?i)\\b(?:[a-z0-9-]+\\.)+(?:com|de|net|org|io|eu|at|ch|info|me|biz)/\\S*",
    "(?i)\\b(?:linkedin|xing|github)\\.com\\S*",
    "(?:\\+|\\b00)\\d[\\d \\t/().-]{6,}\\d",
    "\\b0\\d{2,5}[ \\t/-]?\\d[\\d \\t/-]{4,}\\d\\b"
  ]
}
