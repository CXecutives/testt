#!/bin/sh
# Push guard (versioned copy: .githooks/pre-push). When in doubt, it blocks.
# Enable once per clone: git config core.hooksPath .githooks
#
# 1. Only the two own repos are targets - never a foreign one.
# 2. Old history stays local: no commit descending from one of the old roots, and no
#    "legacy-*" branch leaves the machine.
# 3. Fast-forward only: no force push, no deleting branches/tags on GitHub.
url="$2"
case "$url" in
  https://github.com/CXecutives/testt|https://github.com/CXecutives/testt.git|https://github.com/CXecutives/testt/) ;;
  git@github.com:CXecutives/testt.git|ssh://git@github.com/CXecutives/testt.git) ;;
  https://github.com/CXecutives/TEST|https://github.com/CXecutives/TEST.git|https://github.com/CXecutives/TEST/) ;;
  git@github.com:CXecutives/TEST.git|ssh://git@github.com/CXecutives/TEST.git) ;;
  *)
    echo "BLOCKED: pushing is allowed only to CXecutives/testt or CXecutives/TEST, not to '$url'." >&2
    exit 1 ;;
esac

# Roots of the old history: the Python era and the first TEST state with a real author
# address. Neither may ever reach the public repo.
OLD_PYTHON=9d3b5434dee0f89a47915aa5c5dcc00c57e02168
OLD_TEST=07345a331d7342d3296d41247d61f34adf674569
ZERO=0000000000000000000000000000000000000000
public=0
case "$url" in *testt*) public=1 ;; esac

# "|| [ -n ... ]": a last line without a trailing newline is checked too.
while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  if [ "$local_sha" = "$ZERO" ]; then
    echo "BLOCKED: deleting '$remote_ref' on GitHub - that is done by hand only." >&2
    exit 1
  fi
  case "$local_ref $remote_ref" in
    *legacy-*)
      echo "BLOCKED: '$local_ref' belongs to the old history and stays local." >&2
      exit 1 ;;
  esac
  commit=$(git rev-parse -q --verify "$local_sha^{commit}") || {
    echo "BLOCKED: '$local_ref' points to no commit." >&2
    exit 1
  }
  if git merge-base --is-ancestor "$OLD_PYTHON" "$commit" 2>/dev/null; then
    echo "BLOCKED: '$local_ref' contains the old Python history." >&2
    exit 1
  fi
  if [ "$public" = 1 ] && git merge-base --is-ancestor "$OLD_TEST" "$commit" 2>/dev/null; then
    echo "BLOCKED: '$local_ref' contains the old history with a real author address." >&2
    echo "         The public repo only gets the new, clean history." >&2
    exit 1
  fi
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$commit" 2>/dev/null; then
    echo "BLOCKED: '$remote_ref' would not be a fast-forward (force push or remote state not fetched)." >&2
    exit 1
  fi
done
exit 0
